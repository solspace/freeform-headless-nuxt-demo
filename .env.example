# Craft / Freeform site the Nuxt proxy talks to (defaults to https://site.ddev.site)
CRAFT_PROXY_TARGET=https://site.ddev.site

# Shown in the UI / used as the default form handle
NUXT_PUBLIC_FREEFORM_HANDLE=contact

# Dev server port (`pnpm dev` also passes --port 3002)
NUXT_PORT=3002

# Optional — GraphQL tab (Craft schema token: Freeform form read + submission create + site access)
# NUXT_PUBLIC_GRAPHQL_PATH=/actions/graphql/api
# NUXT_PUBLIC_GRAPHQL_TOKEN=your-craft-graphql-token
