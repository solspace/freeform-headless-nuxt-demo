# Craft site Freeform talks to (no trailing slash)
# Local proxy mode: leave empty and set CRAFT_PROXY_TARGET for Nuxt proxy
# Vercel / other host: set to your Craft URL
NUXT_PUBLIC_FREEFORM_BASE_URL=https://demo.solspace.com

# Optional local-only proxy when NUXT_PUBLIC_FREEFORM_BASE_URL is empty
# CRAFT_PROXY_TARGET=https://demo.solspace.com

NUXT_PUBLIC_FREEFORM_HANDLE=contact

# Optional — GraphQL tab
# NUXT_PUBLIC_GRAPHQL_PATH=/actions/graphql/api
# NUXT_PUBLIC_GRAPHQL_TOKEN=your-craft-graphql-token
